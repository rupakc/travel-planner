# Voyager app settings on the VM (/opt/voyager/app.env). NO SECRETS HERE:
# secrets are Secret Manager secrets, read into memory at container start.
# The disk is snapshotted daily, so anything in this file ends up in snapshots.
# first-boot.sh fills BACKUP_BUCKET, APP_BASE_URL, CORS_ORIGINS and GCP_PROJECT
# from metadata.

# Secret Manager secrets → env vars (secret id = lower-case, dashes).
# Create them EMPTY with bootstrap.sh, then add versions yourself.
# Run infrastructure/gcp/bootstrap.sh (creates the secrets, grants accessor) before adopting this list on the VM.
SECRET_MANAGER_SECRETS=JWT_SECRET_KEY,ADMIN_PASSWORD,SERPAPI_KEY,SERPER_KEY,SMTP_PASSWORD,GOOGLE_CLIENT_SECRET,GITHUB_CLIENT_SECRET,FACEBOOK_APP_SECRET,APPLE_PRIVATE_KEY

# LLM: Gemini on Vertex AI with the VM's service account (ADC, no API key;
# needs aiplatform.endpoints.predict: custom role voyagerGeminiInvoker). No ANTHROPIC_API_KEY in production.
LLM_PROVIDER=gemini
GCP_PROJECT=
GCP_LOCATION=global

# Backups: disk authoritative, user tables to GCS every 5 min when changed
BACKUP_BUCKET=
BACKUP_INTERVAL_SECONDS=300

APP_BASE_URL=
CORS_ORIGINS=[]

# Production guards
ALLOW_ANONYMOUS_AI=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_FAILURES=10
RATE_LIMIT_LOGIN_FAILURES_GLOBAL=200

# Push to the Android app with the VM's service account (no key file)
FCM_USE_ADC=true
# FCM_PROJECT_ID=        # default: the VM's project (GOOGLE_CLOUD_PROJECT)

# SerpAPI free plan: 250 searches/month — keep watches well inside it
FARE_WATCH_DAILY_CALL_BUDGET=6

# Email alerts (password = secret smtp-password); leave SMTP_HOST empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=

ADMIN_USERNAME=admin
ADMIN_EMAIL=

# Accounts (Phase 1). Providers are config-gated: a provider is on only when
# ALL its credentials are non-empty (IDs here, secrets in Secret Manager).
# Uncomment and fill the IDs after adding the secret versions, then restart.
# SIGNUP_MODE=open
# PUBLIC_BASE_URL=       # absolute links (email, OAuth redirect); default APP_BASE_URL
# GOOGLE_CLIENT_ID=
# GITHUB_CLIENT_ID=
# FACEBOOK_APP_ID=
# APPLE_SERVICES_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# Per-account daily AI quota (on top of the 10-minute rate windows)
# AI_DAILY_QUOTA_ENABLED=true
# AI_DAILY_QUOTA_SEARCH=20
# AI_DAILY_QUOTA_CHAT=100
# AI_DAILY_QUOTA_COMPARE=40
# AI_DAILY_QUOTA_DISCOVER=20
# AI_DAILY_QUOTA_LIGHT_AI=200
# AI_DAILY_QUOTA_IMPORT=20
