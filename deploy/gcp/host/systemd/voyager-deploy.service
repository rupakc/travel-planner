[Unit]
Description=Voyager signed-digest deployer (GHCR prod tag → verify → pull → up → health → rollback)
Requires=docker.service
Wants=network-online.target
# After voyager.service: at shutdown a running deploy is stopped *before*
# the app's graceful ExecStop, so its compose run can't race the stop. No
# cycle: deploy.sh only queues voyager.service with --no-block
After=docker.service network-online.target voyager.service

[Service]
Type=oneshot
ExecStart=/opt/voyager/deploy.sh
TimeoutStartSec=20min
