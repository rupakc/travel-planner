[Unit]
Description=Voyager deployer, every minute

[Timer]
OnBootSec=2min
# A run with nothing new is one cached GHCR token + two HEAD requests (no
# pull, no cosign); a merge goes live about a minute after `prod` moves
OnUnitActiveSec=60s
RandomizedDelaySec=5s
AccuracySec=1s

[Install]
WantedBy=timers.target
