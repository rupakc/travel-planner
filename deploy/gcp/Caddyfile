# Voyager edge: TLS (Let's Encrypt, ZeroSSL fallback), the SPA, and /api +
# /health proxied to the app.
#
# Shipped inside the Caddy image (caddy.Dockerfile) together with the SPA, but
# never served from there: the VM's deploy.sh copies both out of every new
# signed image into /var/lib/voyager/edge/releases/<id>/{srv,Caddyfile} and
# switches symlinks (current, prev1, prev2). Caddy mounts that directory
# read-only at /edge and runs with --config /edge/current/Caddyfile, so a new
# SPA goes live without a restart and a changed Caddyfile is reloaded through
# the admin API (open SSE streams keep running).
#
# SITE_HOST: the sslip.io name of the static IP (e.g. 34-23-1-2.sslip.io),
# later your own domain: change it in site.env, no rebuild needed.
{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
	servers {
		# HTTP/1.1 + HTTP/2 only: no UDP (HTTP/3), so every byte is TCP the
		# egress governor can meter
		protocols h1 h2
		# Slow-client (slowloris) limits. No write timeout: SSE streams run
		# for minutes and keepalives arrive every 15 s.
		timeouts {
			read_header 10s
			read_body 2m
			idle 2m
		}
	}
}

{$SITE_HOST} {
	# Screenshots for "plan from a link" (4 × ≤ 5 MB base64) fit; anything
	# larger is refused before it reaches the app (the app checks too)
	request_body {
		max_size 32MB
	}

	# Compress text, but never text/event-stream: SSE must flush per event
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		# The built SPA has no inline scripts and no eval; React and Leaflet
		# set inline styles; map tiles and result images come from anywhere
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}

	@backend path /api/* /health /health/*
	handle @backend {
		reverse_proxy app:8001 {
			# SSE: write every event as it arrives
			flush_interval -1
			# Hold requests while the app restarts during a deploy
			lb_try_duration 30s
			lb_try_interval 250ms
			# Caddy ignores client-sent X-Forwarded-For (no trusted_proxies)
			# and sets it to the real peer; X-Real-IP for logs
			header_up X-Real-IP {remote_host}
		}
	}

	# Link-preview crawlers (chat apps, social networks, search bots) asking for
	# a public share page get the app's small server-rendered HTML page with
	# Open Graph tags; people (any other User-Agent) fall through to the SPA.
	# If the app answers 4xx/5xx (revoked token, sharing off, an older build
	# without the route), the SPA index.html is served instead.
	@crawler {
		header_regexp ua User-Agent (?i)facebookexternalhit|twitterbot|whatsapp|linkedinbot|slackbot|discordbot|telegrambot|pinterest|skypeuri|embedly|googlebot|bingbot|applebot|imessage|redditbot|mastodon
		path_regexp share ^/share/([A-Za-z0-9_-]{8,64})$
	}
	handle @crawler {
		rewrite * /api/share/{re.share.1}/page
		reverse_proxy app:8001 {
			flush_interval -1
			lb_try_duration 30s
			lb_try_interval 250ms
			header_up X-Real-IP {remote_host}
			@apperr status 4xx 5xx
			handle_response @apperr {
				route {
					root * /edge/current/srv
					header Cache-Control "no-cache"
					rewrite * /index.html
					file_server
				}
			}
		}
	}

	# Hashed build assets never change: cache for a year. They are looked up
	# in the current release and the two before it, so a browser still
	# holding an older index.html gets its lazy chunks after a deploy.
	@asset {
		path /assets/*
		file {
			root /edge
			try_files /current/srv{path} /prev1/srv{path} /prev2/srv{path}
		}
	}
	handle @asset {
		root * /edge
		rewrite * {file_match.relative}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# A missing asset is a plain, uncached 404 (never index.html, which would
	# be cached as JS for a year)
	handle /assets/* {
		header Cache-Control "no-store"
		respond 404
	}

	# index.html and SPA routes: always revalidate, so a deploy shows up
	handle {
		root * /edge/current/srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
